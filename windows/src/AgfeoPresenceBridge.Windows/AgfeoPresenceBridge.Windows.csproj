<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- WinForms statt WPF: Ein Programm, das im Infobereich lebt, braucht
         kein XAML. Tray-Symbol, Kontextmenü und ein Dialog mit Reitern sind
         hier Standard und kommen ohne eigene Auszeichnungssprache aus. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AgfeoPresenceBridge</AssemblyName>
    <RootNamespace>AgfeoPresenceBridge.Windows</RootNamespace>
    <Version>1.7.1</Version>
    <!-- Kein Konsolenfenster beim Start. -->
    <ApplicationIcon></ApplicationIcon>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Client" Version="4.66.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgfeoPresenceBridge.Core\AgfeoPresenceBridge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Liegt neben dem Programm und wird beim Start herauskopiert; der Pfad,
         den man im Dashboard einträgt, darf nicht im Programmordner liegen. -->
    <None Update="klick-bridge.cmd" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
